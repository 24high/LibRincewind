<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LibRincewindDemo_4.7.2</AssemblyName>
    <RootNamespace>LibRincewindDemo_4._7._2</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Form1.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\Resources.cs" />
    <Compile Include="Properties\Settings.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <EmbeddedResource Include="Form1.resx" />
    <EmbeddedResource Include="Properties\Resources.resx" />
  </ItemGroup>

  <!--
    The plugin and RNG assemblies are loaded at run time by file name from the application
    directory, not linked against. They are referenced here purely so the build copies them
    next to the .exe; ReferenceOutputAssembly=false keeps them off the compile-time
    reference set, which is what the plugin architecture intends.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\LibRincewind_4.7.2\LibRincewind_4.7.2\LibRincewind_4.7.2.csproj" />
    <ProjectReference Include="..\..\LibRincewindPlugin_4.7.2\LibRincewindPlugin_4.7.2.csproj" />
    <ProjectReference Include="..\..\LibRincewindPlugin_ChaCha20_4.7.2\LibRincewindPlugin_ChaCha20_4.7.2.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\..\LibRincewindPlugin_RC4Plus_4.7.2\LibRincewindPlugin_RC4Plus_4.7.2.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\..\LibRincewindRNG_Generic_API\LibRincewindRNG_Generic_API.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\..\LibRincewindRNG_HardwareRNG\LibRincewindRNG_HardwareRNG.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\..\LibRincewindRNG_QRNG-API\LibRincewindRNG_QRNG-LFDR.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

</Project>
