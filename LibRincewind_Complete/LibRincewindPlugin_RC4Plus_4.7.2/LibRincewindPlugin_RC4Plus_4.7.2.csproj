<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>LibRincewindPlugin_RC4Plus_4.7.2</AssemblyName>
    <RootNamespace>LibRincewindPlugin_RC4Plus_4._7._2</RootNamespace>
  </PropertyGroup>

  <!--
    The rewritten RC4Plus is BCL-only: AES-CTR XOR HMAC-SHA512-CTR. The legacy project
    still referenced NAudio, Konscious and half a dozen System.* compat packages that the
    current sources no longer touch; those references are gone.
  -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Blowfish.cs" />
    <Compile Include="RC4Plus.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibRincewindPlugin_4.7.2\LibRincewindPlugin_4.7.2.csproj" />
  </ItemGroup>

</Project>
